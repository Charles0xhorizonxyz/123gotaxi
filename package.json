{
  "name": "123go-taxi",
  "version": "0.1.0",
  "private": true,
  "description": "Turn an address into a QR code a taxi driver can scan to start navigation in their own app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "iphone": "playwright open --browser=webkit --device=\"iPhone 15\" https://123go.taxi",
    "iphone:local": "playwright open --browser=webkit --device=\"iPhone 15\" http://localhost:5173"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "jsqr": "1.4.0",
    "qrcode": "^1.5.4"
  }
}
